@@ -18,22 +18,58 @@ class OpenAIEmbedding(Embedding):
     MAX_TOKENS = 8191
 
     def __init__(
-        self, model: str = "text-embedding-3-small", embedding_dims: int = 1536
+        self,
+        model: Optional[str] = None,
+        embedding_dims: Optional[int] = None,
+        base_url: Optional[str] = None,
+        api_key: Optional[str] = None,
     ):
+        """Embeddings, addressable independently of the chat endpoint.
 
-        self.model = model
-        self.embedding_dims = embedding_dims
+        Upstream reads OPENAI_API_BASE / OPENAI_BASE_URL here — the same pair the
+        chat client reads (`recmem/llm/openai.py:32-36`) — so pointing chat at a
+        provider that serves no embeddings (DeepSeek has no /v1/embeddings at
+        all) silently drags this client there too, and the first add_memory dies
+        as `RuntimeError: Failed to embed text after 3 retries`.
 
-        api_key = os.getenv("OPENAI_API_KEY")
+        EMBEDDING_API_BASE / EMBEDDING_API_KEY are checked first so the two legs
+        can go to different providers. Everything falls back to the old
+        behaviour, so an unset environment behaves exactly as before.
+        """
+        self.model = model or os.getenv("EMBEDDING_MODEL") or "text-embedding-3-small"
+        self.embedding_dims = (
+            embedding_dims
+            if embedding_dims is not None
+            else int(os.getenv("EMBEDDING_DIM") or 1536)
+        )
+
+        api_key = api_key or os.getenv("EMBEDDING_API_KEY") or os.getenv("OPENAI_API_KEY")
         base_url = (
-            os.getenv("OPENAI_API_BASE")
+            base_url
+            or os.getenv("EMBEDDING_API_BASE")
+            or os.getenv("OPENAI_API_BASE")
             or os.getenv("OPENAI_BASE_URL")
             or "https://api.openai.com/v1"
         )
 
+        # `dimensions` is a text-embedding-3-* parameter. Sending it to bge-m3,
+        # bce, or most relays is a 400, and sending it to a model with a fixed
+        # width is meaningless. Default: send it only for the family that
+        # defines it. EMBEDDING_SEND_DIMENSIONS=1/0 overrides either way.
+        override = os.getenv("EMBEDDING_SEND_DIMENSIONS")
+        self.send_dimensions = (
+            override.strip().lower() in {"1", "true", "yes"}
+            if override is not None
+            else self.model.startswith("text-embedding-3")
+        )
+
         self.client = OpenAI(api_key=api_key, base_url=base_url)
         self._tokenizer: Optional[tiktoken.Encoding] = None
 
+    def _extra(self) -> dict:
+        """`dimensions=` only where the provider defines it. See __init__."""
+        return {"dimensions": self.embedding_dims} if self.send_dimensions else {}
+
     @property
     def dim(self) -> int:
         return self.embedding_dims
