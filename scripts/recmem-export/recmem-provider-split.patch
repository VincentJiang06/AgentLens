+import os
 from abc import ABC, abstractmethod
 from typing import List
 
@@ -25,3 +26,16 @@ class Embedding(ABC):
     def dim(self) -> int:
         """The dimensionality of vectors produced by this embedder."""
         ...
+
+
+def default_embedding_dim() -> int:
+    """The vector width every Qdrant collection is created with.
+
+    Upstream hardcodes 1536 (text-embedding-3-small) at five sites. A provider
+    with a different width — bge-m3 is 1024 — then fails at
+    `QdrantStore.add`'s dimension check, which is at least loud. Reading one env
+    var keeps the five sites from drifting apart, and EMBEDDING_DIM is the same
+    variable OpenAIEmbedding reads, so the store and the embedder cannot
+    disagree.
+    """
+    return int(os.getenv("EMBEDDING_DIM") or 1536)
